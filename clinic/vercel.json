{
  "rewrites": [
    {
      "source": "/super-admin",
      "destination": "https://swift-vet-super-admin.vercel.app/"
    },
    {
      "source": "/super-admin/:match*",
      "destination": "https://swift-vet-super-admin.vercel.app/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}